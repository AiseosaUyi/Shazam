{
  "manifest_version": 3,
  "name": "Arcwork Browser Bridge",
  "version": "1.1.0",
  "description": "Lets your Arcwork agents browse in your real Chrome: open pages, read, click and type, with your approval.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "debugger",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Arcwork Browser Bridge",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon128.png"
  }
}