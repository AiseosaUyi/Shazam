{
  "name": "shazam-ai",
  "version": "0.3.0",
  "private": true,
  "main": "desktop/main.js",
  "bin": {
    "shazam": "./cli/shazam-cli.js",
    "shazam-agent": "./cli/index.js",
    "shazam-bridge": "./cli/bridge.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-sqlite --no-warnings --import tsx --test tests/*.test.ts",
    "eval:agent": "tsx scripts/eval-agent.ts",
    "eval:agent:dry": "tsx scripts/eval-agent.ts --dry",
    "desktop": "electron desktop/main.js",
    "desktop:dist": "electron-builder --mac --arm64",
    "cli": "node cli/shazam-cli.js",
    "daemon": "node cli/index.js",
    "companion": "node cli/index.js",
    "db:migrate:local": "wrangler d1 migrations apply shazam-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply shazam-db --remote",
    "build:cf": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "preview": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "prebuild": "node scripts/gen-migrations.mjs && node scripts/gen-bridge.mjs",
    "pretest": "node scripts/gen-migrations.mjs",
    "bridge": "node cli/bridge.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.92",
    "@ai-sdk/google": "^4.0.108",
    "@ai-sdk/openai": "^4.0.105",
    "@ai-sdk/openai-compatible": "^3.0.81",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@opennextjs/cloudflare": "1.20.10",
    "@vercel/blob": "^2.8.2",
    "@vercel/sandbox": "^3.9.1",
    "ai": "^7.0.157",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.475.0",
    "mcp-handler": "^2.3.0",
    "next": "15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "4.149.0"
  }
}
