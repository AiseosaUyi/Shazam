# Shazam AI — Environment Configuration
# Node Environment
NODE_ENV=development
PORT=3000

# Security & Encryption (AES-256-GCM 32-byte hex secret for BYOK Vault)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHAZAM_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=development-jwt-secret-replace-in-production-min-32-chars

# Database Configuration (PostgreSQL in production; in-memory/sqlite fallback in dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shazam_ai

# Optional System Default Provider Keys (Users can bring their own keys via BYOK)
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
HUGGINGFACE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=

# Sandbox & Execution Limits
AGENT_SANDBOX_DIR=./data/sandbox
AGENT_MAX_EXEC_TIME_MS=30000
